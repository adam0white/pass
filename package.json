{
  "name": "pass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Pass: six dinner services in your late aunt's lokanta. Every cook can say no.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test:ui": "playwright test",
    "check:lane": "npm run check"
  },
  "dependencies": {
    "@adam0white/human-framework": "4.7.0",
    "@adam0white/lab-client": "https://github.com/adam0white/human-framework/releases/download/lab-client-v0.5.3/adam0white-lab-client-0.5.3.tgz",
    "@adam0white/lab-kit": "https://github.com/adam0white/human-framework/releases/download/lab-kit-v0.5.21/adam0white-lab-kit-0.5.21.tgz",
    "@adam0white/human-framework-legacy": "npm:@adam0white/human-framework@3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
